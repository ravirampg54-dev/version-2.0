{
  "name": "rpg-todo",
  "version": "2.0.0",
  "private": true,
  "description": "RPG Todo offline productivity app with tasks, notes, timer, alarms, and notifications, built with HTML, CSS, JavaScript, and Capacitor.",
  "scripts": {
    "start": "npx serve -s www -l 8080",
    "dev": "npx serve -s www -l 8080",
    "build": "npx cap sync android",
    "build:web": "node scripts/build-web.js",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:generate": "npx @capacitor/assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.1",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.2.1",
    "@capacitor/core": "^7.2.1",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/splash-screen": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "serve": "^14.2.1"
  }
}
